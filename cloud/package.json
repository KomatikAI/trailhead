    "hono": "^4.12.15",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "tsx": "^4.22.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  }
}
